---
/**
 * Meet the Team.
 *
 * DELTA vs hackutd: the diagonal background strip behind this section is the
 * campus photo (WHI.jpg) with a subtle scroll PARALLAX (rAF + translateY),
 * clipped to skewed band edges and darkened for legibility. Parallax is fully
 * disabled under prefers-reduced-motion (static image stands).
 *
 * PLACEHOLDER ×2 in the leadership block:
 *   - photo frame (no leadership photo exists yet; the officers group shot
 *     lives in Our Mission)
 *   - quote slot ("note coming soon") — the attribution names and titles are
 *     real (team.yaml); the quote text must never be invented.
 *
 * Officers without a headshot (new seats, unfilled seats) render the dashed
 * "headshot pending" footprint — same convention as csa-website.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import campus from '../assets/campus/whi.jpg';

const officers = (await getCollection('officers'))
  .map((o) => o.data)
  .sort((a, b) => a.order - b.order);

/**
 * The full board (12 seats) fits on one page today, so the pager stays
 * dormant; it wakes automatically on the 13th officer. Page 1: twelve
 * officers · page 2: the remainder. All pages stay in the DOM.
 */
const PAGE_SIZE = 12;
const pages: (typeof officers)[] = [];
for (let i = 0; i < officers.length; i += PAGE_SIZE) pages.push(officers.slice(i, i + PAGE_SIZE));
---

<section id="team" class="relative isolate scroll-mt-20 overflow-x-clip py-24 md:py-32">
  {/* ---- Diagonal campus band w/ parallax (decorative) ---- */}
  <div class="team-band pointer-events-none absolute inset-x-0 bottom-[2%] top-[14%] -z-10" aria-hidden="true">
    <div class="band-clip absolute inset-0 overflow-hidden">
      <img
        id="team-parallax"
        src={campus.src}
        alt=""
        class="absolute left-0 top-[-15%] h-[130%] w-full object-cover blur-[2px] will-change-transform"
      />
      <div class="absolute inset-0 bg-[#0a0812]/82"></div>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4">
    <SectionHead title="Meet the Team" align="left" />

    {/* ---- Leadership block: photo slot + quote slot (both declared placeholders) ---- */}
    <div class="grid items-center gap-10 md:grid-cols-[minmax(0,26rem)_1fr] md:gap-16">
      <div
        class="flex aspect-[4/3] flex-col items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-white/15 bg-white/[0.03] p-6 text-center backdrop-blur-sm"
        role="img"
        aria-label="Placeholder: leadership photo slot reserved"
      >
        <Icon name="camera" class="h-10 w-10 text-white/30" />
        <p class="text-sm font-extrabold uppercase tracking-[0.18em] text-white/45">
          Leadership photo
        </p>
        <p class="max-w-56 text-xs leading-relaxed text-white/35">Slot reserved</p>
      </div>

      <figure>
        <div class="grad-text text-6xl font-extrabold leading-none md:text-7xl" aria-hidden="true">
          &ldquo;
        </div>
        <blockquote
          class="mt-1 text-2xl font-bold text-white/50 md:text-3xl"
          title="Placeholder: awaiting a real quote from John and Nelson"
        >
          A note from our leads is coming soon.
        </blockquote>
        <figcaption class="mt-6">
          <p class="text-base font-extrabold text-white md:text-lg">
            John Pierre <span class="text-white/50">&amp;</span> Nelson Aviles
          </p>
          <p class="text-sm font-semibold text-white/60">
            President &amp; Vice President, Computer Science Association
          </p>
        </figcaption>
      </figure>
    </div>

    {/* ---- Officers rail: paged grid with prev/next arrows ---- */}
    <div class="off mt-20 md:mt-24" data-officers>
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <h3 class="text-xl font-extrabold text-white md:text-2xl">The officers behind HackHCC</h3>
        <div class="off-nav hidden items-center gap-3">
          <button
            type="button"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white transition hover:border-white/40 hover:bg-white/10"
            data-dir="-1"
            aria-label="Previous officers page"
          >
            <Icon name="chevron-left" class="h-5 w-5" />
          </button>
          <span class="min-w-10 text-center text-sm font-extrabold text-white/60" data-status aria-live="polite">
            1 / {pages.length}
          </span>
          <button
            type="button"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-white/5 text-white transition hover:border-white/40 hover:bg-white/10"
            data-dir="1"
            aria-label="Next officers page"
          >
            <Icon name="chevron-right" class="h-5 w-5" />
          </button>
        </div>
      </div>

      <div class="off-pages space-y-10" role="group" aria-roledescription="carousel" aria-label="HackHCC officers">
        {
          pages.map((page, pi) => (
            <ul
              class:list={[
                'off-page',
                page.length >= 5
                  ? 'grid grid-cols-2 gap-x-5 gap-y-9 sm:grid-cols-3 lg:grid-cols-4'
                  : 'flex flex-wrap justify-center gap-9',
              ]}
              data-page={pi}
            >
              {page.map((o) => (
                <li class:list={['flex flex-col text-center', page.length < 5 && 'w-40 md:w-44']}>
                  {
                    o.photo ? (
                      <div class="overflow-hidden rounded-2xl border border-white/10 bg-panel">
                        <Image
                          src={o.photo}
                          alt={`Portrait of ${o.name}`}
                          width={480}
                          height={480}
                          class="aspect-square w-full object-cover"
                        />
                      </div>
                    ) : (
                      <div
                        class="flex aspect-square w-full flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-white/15 bg-white/[0.03]"
                        role="img"
                        aria-label={`Placeholder: no headshot for ${o.name} yet`}
                      >
                        <Icon name="camera" class="h-7 w-7 text-white/25" />
                        <p class="text-[10px] font-extrabold uppercase tracking-[0.18em] text-white/40">
                          Headshot pending
                        </p>
                      </div>
                    )
                  }
                  <p
                    class:list={[
                      'mt-3 text-sm font-extrabold leading-tight md:text-[15px]',
                      o.name === 'Name TBA' ? 'text-white/50' : 'text-white',
                    ]}
                  >
                    {o.name}
                  </p>
                  <p class="mt-0.5 text-xs font-semibold text-white/55 md:text-[13px]">{o.role}</p>
                  <p class="mt-auto flex items-center justify-center gap-2.5 pt-1.5">
                    {o.linkedin && (
                      <a
                        href={o.linkedin}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-white/45 transition hover:text-accent"
                        aria-label={`${o.name} on LinkedIn`}
                      >
                        <Icon name="linkedin" class="h-4 w-4" />
                      </a>
                    )}
                    {o.github && (
                      <a
                        href={o.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-white/45 transition hover:text-accent"
                        aria-label={`${o.name} on GitHub`}
                      >
                        <Icon name="github" class="h-4 w-4" />
                      </a>
                    )}
                  </p>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Skewed band edges, hackutd-strip style. */
  .band-clip {
    clip-path: polygon(0 7%, 100% 0%, 100% 93%, 0 100%);
  }
</style>

<script>
  // ---- Campus-photo parallax (skipped entirely under reduced motion) ----
  const img = document.getElementById('team-parallax');
  if (img && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const band = img.closest<HTMLElement>('.team-band')!;
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = band.getBoundingClientRect();
      const mid = r.top + r.height / 2 - window.innerHeight / 2;
      // Subtle counter-scroll: the photo drifts against the page, ±34px max.
      const shift = Math.max(-1, Math.min(1, mid / window.innerHeight)) * -34;
      img.style.transform = `translate3d(0, ${shift}px, 0)`;
    };
    const queue = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    update();
  }

  // ---- Officers pager (no JS → all pages simply stack) ----
  const off = document.querySelector<HTMLElement>('[data-officers]');
  if (off) {
    const pages = [...off.querySelectorAll<HTMLElement>('.off-page')];
    if (pages.length > 1) {
      const nav = off.querySelector<HTMLElement>('.off-nav')!;
      const status = off.querySelector<HTMLElement>('[data-status]')!;
      const pagesWrap = off.querySelector<HTMLElement>('.off-pages')!;
      nav.classList.remove('hidden');
      nav.classList.add('flex');
      let page = 0;

      const apply = () => {
        pages.forEach((p, k) => {
          p.hidden = k !== page;
          p.setAttribute('aria-hidden', String(k !== page));
        });
        status.textContent = `${page + 1} / ${pages.length}`;
      };
      const go = (n: number) => {
        page = (n + pages.length) % pages.length;
        apply();
      };

      off
        .querySelectorAll<HTMLButtonElement>('[data-dir]')
        .forEach((btn) =>
          btn.addEventListener('click', () => go(page + Number(btn.dataset.dir))),
        );
      pagesWrap.tabIndex = 0;
      pagesWrap.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          go(page - 1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          go(page + 1);
        }
      });

      apply();
    }
  }
</script>
