---
/**
 * Hackathons — hackutd-style centered big-card carousel with side arrows and
 * dot pagination. Two slides:
 *   (a) Code Runners 2026 — real cover art and four confirmed stat chips
 *       (100+ Hackers, 24 Hours, 28 Projects, 14 Sponsors). Card links to
 *       the edition site.
 *   (b) Control Z 2027 — artwork-under-wraps placeholder; nothing invented.
 *
 * Degrades to stacked cards without JS; arrows/dots appear only when the
 * script enhances the block. Keyboard: ← / → on the focused viewport.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';

const events = (await getCollection('events'))
  .map((e) => e.data)
  .sort((a, b) => a.order - b.order);

const codeRunners = events.find((e) => e.name === 'Code Runners');
const controlZ = events.find((e) => e.name === 'Control Z');
if (!codeRunners || !controlZ) throw new Error('Expected both edition entries');

/** Confirmed chips for the 4-chip row (from the content collection). */
const chips = codeRunners.stats.filter((s) => s.label !== 'Edition');
---

<section id="hackathons" class="scroll-mt-20 overflow-x-clip">
  <div class="mx-auto max-w-5xl px-4 py-24 md:py-32">
    <SectionHead title="Hackathons" align="right" />

    <div class="hx relative" data-carousel>
      <button
        type="button"
        class="hx-btn absolute -left-2 top-[38%] z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-ground/80 text-white backdrop-blur transition hover:border-white/40 hover:bg-white/10 lg:-left-16"
        data-dir="-1"
        aria-label="Previous edition"
      >
        <Icon name="chevron-left" class="h-5 w-5" />
      </button>
      <button
        type="button"
        class="hx-btn absolute -right-2 top-[38%] z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-ground/80 text-white backdrop-blur transition hover:border-white/40 hover:bg-white/10 lg:-right-16"
        data-dir="1"
        aria-label="Next edition"
      >
        <Icon name="chevron-right" class="h-5 w-5" />
      </button>

      <div
        class="hx-viewport overflow-hidden rounded-2xl"
        role="region"
        aria-roledescription="carousel"
        aria-label="HackHCC editions"
      >
        <ul class="hx-track">
          {/* ---- Slide 1 · Code Runners 2026 (real, past) ---- */}
          <li class="hx-slide" data-slide>
            <a
              href={codeRunners.siteUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group block overflow-hidden rounded-2xl border border-white/10 bg-panel transition hover:border-white/30"
            >
              <div class="flex aspect-[16/8] items-center justify-center bg-[#100a1c] p-8 md:p-14">
                {
                  codeRunners.cover && (
                    <Image
                      src={codeRunners.cover}
                      alt="Code Runners 2026 cover art"
                      widths={[640, 1035]}
                      sizes="(min-width: 1024px) 900px, 92vw"
                      class="max-h-full w-auto max-w-full drop-shadow-[0_12px_40px_rgba(139,92,246,0.25)] transition duration-300 group-hover:scale-[1.02]"
                    />
                  )
                }
              </div>
              <div
                class="flex flex-wrap items-center justify-between gap-2 border-t border-white/10 px-5 py-4 md:px-7"
              >
                <p class="text-base font-extrabold text-white md:text-lg">
                  {codeRunners.name}
                  <span class="ml-2 text-sm font-bold text-white/50">Edition {codeRunners.ordinal} · {codeRunners.venue}</span>
                </p>
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-white/60">
                  Official MLH Member Event
                  <Icon
                    name="chevron-right"
                    class="h-4 w-4 text-white/50 transition group-hover:translate-x-0.5 group-hover:text-white"
                  />
                </p>
              </div>
            </a>
            <p class="mt-5 text-center text-base font-extrabold tracking-wide text-white/70">
              {codeRunners.edition}
            </p>
            <ul class="mt-4 flex flex-wrap items-center justify-center gap-3">
              {
                chips.map((s) => (
                  <li class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/[0.05] px-4 py-1.5 text-sm font-bold text-white/85">
                    <span class="grad-text font-extrabold">{s.value}</span> {s.label}
                  </li>
                ))
              }
            </ul>
          </li>

          {/* ---- Slide 2 · Control Z 2027 (upcoming, unannounced) ---- */}
          <li class="hx-slide" data-slide>
            <div
              class="flex aspect-[16/8] flex-col items-center justify-center gap-4 rounded-2xl border-2 border-dashed border-white/15 bg-white/[0.02] px-6 text-center"
            >
              <p class="grad-text text-4xl font-extrabold tracking-tight md:text-6xl">Control Z</p>
              <p class="text-sm font-extrabold uppercase tracking-[0.22em] text-white/45">
                Artwork under wraps
              </p>
              <p class="max-w-md text-sm leading-relaxed text-white/40">{controlZ.blurb}</p>
            </div>
            <p class="mt-5 text-center text-base font-extrabold tracking-wide text-white/70">
              {controlZ.edition}, not announced yet
            </p>
          </li>
        </ul>
      </div>

      <div class="hx-dots mt-8 hidden justify-center gap-2.5" role="tablist" aria-label="Choose edition">
        <button
          type="button"
          role="tab"
          data-index="0"
          aria-label="Code Runners 2026"
          class="hx-dot h-2.5 w-2.5 rounded-full bg-white/25 transition"
        ></button>
        <button
          type="button"
          role="tab"
          data-index="1"
          aria-label="Control Z 2027"
          class="hx-dot h-2.5 w-2.5 rounded-full bg-white/25 transition"
        ></button>
      </div>
    </div>
  </div>
</section>

<style>
  /* No-JS default: slides stack; controls stay hidden. */
  .hx-track {
    display: grid;
    gap: 3rem;
  }
  /* Enhanced: a sliding row. */
  .hx.is-on .hx-track {
    display: flex;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .hx.is-on .hx-slide {
    width: 100%;
    flex-shrink: 0;
  }
  .hx.is-on :global(.hx-btn) {
    display: flex;
  }
  .hx.is-on .hx-dots {
    display: flex;
  }
  .hx-dot[aria-selected='true'] {
    background: linear-gradient(92deg, #8b5cf6, #ec4899, #f97316);
    transform: scale(1.25);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-carousel].hx');
  if (root) {
    root.classList.add('is-on');
    const viewport = root.querySelector<HTMLElement>('.hx-viewport')!;
    const track = root.querySelector<HTMLElement>('.hx-track')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.hx-dot')];
    let index = 0;

    const apply = () => {
      track.style.transform = `translateX(-${index * 100}%)`;
      slides.forEach((slide, k) => {
        slide.setAttribute('aria-hidden', String(k !== index));
        slide
          .querySelectorAll<HTMLElement>('a, button')
          .forEach((el) => (el.tabIndex = k === index ? 0 : -1));
      });
      dots.forEach((dot, k) => dot.setAttribute('aria-selected', String(k === index)));
    };
    const go = (n: number) => {
      index = (n + slides.length) % slides.length;
      apply();
    };

    root
      .querySelectorAll<HTMLButtonElement>('[data-dir]')
      .forEach((btn) =>
        btn.addEventListener('click', () => go(index + Number(btn.dataset.dir))),
      );
    dots.forEach((dot) =>
      dot.addEventListener('click', () => go(Number(dot.dataset.index))),
    );

    viewport.tabIndex = 0;
    viewport.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(index + 1);
      }
    });

    apply();
  }
</script>
