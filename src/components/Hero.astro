---
/**
 * Full-viewport hero. DELTA vs hackutd: no skyline art and no color-gradient
 * background — the backdrop is a muted looping video segment behind a neutral
 * BLACK scrim. Below the tagline sit the edition chip and the hackutd-style
 * edition card (glowing screenshot tile + corner cursor) — both link to the
 * FEATURED edition: the newest one in the events collection with a site.
 * Swapping editions is a JSON edit (`src/content/events/`), not a code edit.
 *
 * Video source, in priority order:
 *   1. `public/hero.mp4` → native <video>, checked at build time, with
 *      `public/hero-poster.jpg` (its first frame) as the poster so the city
 *      shows the moment the page paints. No player UI, seamless loop.
 *   2. Otherwise the YouTube segment configured in `heroVideo` (site.ts):
 *      a muted, chromeless embed controlled through the official IFrame
 *      Player API, looping `startSeconds`→`endSeconds` (see the script).
 *
 * Fallbacks: with prefers-reduced-motion or without JS, no video mounts and
 * the plain near-black poster ground stands.
 */
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { site, heroVideo } from '../data/site';
import Icon from './Icon.astro';

// Resolved from the project root: at build time this component runs from a
// bundled chunk, so a path relative to import.meta.url never finds public/.
const inPublic = (file: string) => fs.existsSync(path.join(process.cwd(), 'public', file));
const hasLocalVideo = inPublic('hero.mp4');
const hasPoster = inPublic('hero-poster.jpg');

const featured = (await getCollection('events'))
  .map((e) => e.data)
  // Same "live" rule as the Hackathons carousel, plus a preview for the card.
  .filter((e) => e.status !== 'upcoming' && e.siteUrl && e.cover && e.preview)
  .sort((a, b) => b.order - a.order)[0];
if (!featured) throw new Error('Hero: no edition has siteUrl + cover + preview to feature');

const ORDINAL_WORDS: Record<string, string> = { '01': 'first', '02': 'second', '03': 'third', '04': 'fourth', '05': 'fifth' };
const which = ORDINAL_WORDS[featured.ordinal] ?? `no. ${featured.ordinal}`;
const label = `${featured.name} ${featured.edition}`;
---

{
  !hasLocalVideo && (
    <>
      <link rel="preconnect" href="https://www.youtube-nocookie.com" />
      <link rel="preconnect" href="https://www.youtube.com" />
      <link rel="preconnect" href="https://www.google.com" />
    </>
  )
}

<section id="top" class="relative flex min-h-svh items-center justify-center overflow-hidden bg-[#050309]">
  {/* ---- Media layer (aria-hidden, pointer-events off, purely decorative) ---- */}
  {
    hasLocalVideo ? (
      <video
        class="hero-media pointer-events-none absolute inset-0 h-full w-full object-cover"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster={hasPoster ? '/hero-poster.jpg' : undefined}
        src={heroVideo.localHeroVideo}
        aria-hidden="true"
      />
    ) : (
      <div
        id="hero-yt-wrap"
        class="pointer-events-none absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2"
        aria-hidden="true"
        data-yt-id={heroVideo.youtubeId}
        data-yt-start={heroVideo.startSeconds}
        data-yt-end={heroVideo.endSeconds}
      />
    )
  }

  {/* ---- Neutral black scrim for legibility (no colored gradients here) ---- */}
  <div class="absolute inset-0 bg-black/55" aria-hidden="true"></div>
  <div class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-black/75 to-transparent" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-44 bg-gradient-to-t from-black/75 to-transparent" aria-hidden="true"></div>

  {/* ---- Foreground stack ---- */}
  <div class="relative z-10 flex flex-col items-center px-4 pb-24 pt-28 text-center md:pt-32">
    <p class="text-lg font-semibold tracking-wide text-white/90 md:text-xl">We are</p>
    <h1
      class="mt-1 text-[16.5vw] font-extrabold leading-none tracking-tight text-white md:text-9xl lg:text-[10.5rem]"
      style="text-shadow: 0 4px 44px rgba(0,0,0,.6);"
    >
      HackHCC
    </h1>
    <p class="mt-5 max-w-2xl text-balance text-lg font-medium text-white/85 md:text-2xl">
      {site.tagline}
    </p>

    {/* Featured-edition banner chip → the featured edition's subdomain */}
    <a
      href={featured.siteUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group mt-10 inline-flex items-center gap-3 rounded-full border border-white/20 bg-white/10 py-2.5 pl-4 pr-5 backdrop-blur-md transition hover:border-white/45 hover:bg-white/15"
    >
      <Image src={featured.cover!} alt="" width={320} loading="eager" class="h-6 w-auto md:h-8" />
      <span class="text-sm font-bold text-white md:text-[15px]">
        {label}: visit the {which} edition
      </span>
      <Icon
        name="chevron-right"
        class="h-4 w-4 shrink-0 text-white/70 transition group-hover:translate-x-0.5 group-hover:text-white"
      />
    </a>

    {/*
      Edition card, hackutd-style: the big glowing preview card linking to
      the latest edition site, with a cursor glyph parked at its corner that
      hides on hover (your own cursor takes its place). The cursor arrow is
      drawn fresh as a path — no downloaded artwork.
    */}
    <a
      href={featured.siteUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="edition-card mt-9"
      aria-label={`Open the ${label} edition site`}
    >
      <Image src={featured.preview!} alt="" width={720} loading="eager" class="edition-card-logo" />
      <svg class="edition-card-cursor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M5 2.2 18.6 13.2l-6.3.9 3.5 7.2-3 1.4-3.4-7.2L5 19.8z"
          fill="#fff"
          stroke="#000"
          stroke-width="1.5"
          stroke-linejoin="round"
          transform="rotate(-10 12 12)"
        />
      </svg>
    </a>
  </div>

  {/* Bouncing scroll cue (still under prefers-reduced-motion) */}
  <a
    href="#mission"
    class="absolute bottom-5 left-1/2 z-10 -translate-x-1/2 rounded-full p-2 text-white/80 transition hover:text-white motion-safe:animate-bounce"
    aria-label="Scroll down to Our Mission"
  >
    <Icon name="chevron-down" class="h-8 w-8" />
  </a>
</section>

<style is:global>
  /* Each player is invisible until the script shows it: never while it is
     loading, and never while YouTube's own controls are on screen. */
  #hero-yt-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  #hero-yt-wrap iframe.is-shown {
    opacity: 1;
  }

  /* ---- Edition card (hackutd's glowing logo tile, rebuilt) ---- */
  .edition-card {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 130px;
    padding: 0.45rem;
    border-radius: 35px;
    background: #1a2132;
    box-shadow: 0 4px 20px 3px rgba(91, 0, 71, 0.6);
    transition:
      box-shadow 0.4s,
      transform 0.4s;
    animation: edition-card-in 0.9s;
  }
  .edition-card:hover {
    transform: translateY(2px);
    box-shadow: 0 4px 10px 2px rgba(91, 0, 71, 0.6);
  }
  .edition-card-logo {
    height: 100%;
    width: auto;
    border-radius: 28px;
  }
  .edition-card-cursor {
    position: absolute;
    right: -18px;
    bottom: -14px;
    height: 45%;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.45));
    transition: opacity 0.2s;
    animation: edition-cursor-in 0.9s;
  }
  .edition-card:hover .edition-card-cursor {
    opacity: 0;
  }
  @keyframes edition-card-in {
    0%,
    50% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes edition-cursor-in {
    0%,
    50% {
      opacity: 0;
      transform: translateY(-50px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (max-width: 767px) {
    .edition-card {
      height: 100px;
      border-radius: 28px;
    }
    .edition-card-logo {
      border-radius: 21px;
    }
    .edition-card-cursor {
      right: -12px;
      bottom: -10px;
    }
  }

  /* Reduced motion: the native local video (if any) never shows either. */
  @media (prefers-reduced-motion: reduce) {
    .hero-media {
      display: none;
    }
  }
</style>

<script>
  /**
   * Muted looping YouTube background, controlled through the official IFrame
   * Player API. Mounts nothing under prefers-reduced-motion or Save-Data (the
   * poster ground stands), and with JS off this whole block never runs.
   *
   * SPEED: the embed iframe is created as soon as this script runs, with the
   * API loading alongside it (the API attaches to the existing frame), so the
   * player no longer waits for the whole page and then for the API. YouTube
   * picks the stream quality from the player's size, so the frame is laid out
   * ~720 device pixels tall and scaled up with CSS: behind the dark scrim it
   * looks the same as 1080p, for a fraction of the bytes.
   *
   * THE LOOP: whenever playback starts or resumes (first play, a seek, a
   * restart), YouTube's player draws a big play/pause button in its centre
   * for about four seconds, even with controls=0, and there is no setting to
   * turn it off. The first player fades in the moment it plays, so the video
   * shows as early as possible and that button shows on first load. The loop
   * never seeks: shortly before `endSeconds` a second player starts a few
   * seconds before `startSeconds`, out of sight, plays until its button has
   * gone (HIDE_MS), then the two crossfade and the old one is removed. So
   * every loop after the first play is seamless, with no button.
   *
   * COST: when the hero scrolls out of view the players are removed outright,
   * so nothing decodes or downloads behind the rest of the page; scrolling
   * back starts a fresh one.
   */
  const wrap = document.getElementById('hero-yt-wrap');
  const saveData = (navigator as any).connection?.saveData === true;
  if (wrap && !saveData && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const videoId = wrap.dataset.ytId ?? '';
    const start = Number(wrap.dataset.ytStart ?? 0);
    const end = Number(wrap.dataset.ytEnd ?? 0);
    const section = wrap.closest('section')!;

    /** How long YouTube keeps its centre play/pause button up after playback starts (measured ~4.4 s). */
    const HIDE_MS = 5000;
    /** Each player starts this much earlier, so it is at `start` when it fades in. */
    const WARM_START = Math.max(0, Math.floor(start - HIDE_MS / 1000));
    /** Seconds before `end` that the next player starts warming up (load + HIDE_MS). */
    const PREP = 8.5;
    /** Crossfade length (matches the CSS transition), and how far past `end` to wait for a late player. */
    const FADE = 0.6;
    const OVERRUN = 3;
    const PLAYING = 1;
    const ENDED = 0;

    // Oversize the 16:9 frame past the section so it covers like
    // object-fit: cover, with margin to push YouTube's UI chrome offscreen.
    const OVERSCAN = 1.32;
    // Lay the frame out this many DEVICE pixels tall, then scale it up.
    const STREAM_HEIGHT = 720;
    const size = () => {
      const vw = section.clientWidth || window.innerWidth;
      const vh = section.clientHeight || window.innerHeight;
      const coverH = Math.max(vh, (vw * 9) / 16) * OVERSCAN;
      const layoutH = Math.min(coverH, Math.max(240, STREAM_HEIGHT / (window.devicePixelRatio || 1)));
      wrap.style.width = `${Math.ceil((layoutH * 16) / 9)}px`;
      wrap.style.height = `${Math.ceil(layoutH)}px`;
      wrap.style.scale = String(coverH / layoutH);
    };
    // Section size changes without a window resize too (font swap, mobile
    // address bar), so watch the section itself.
    const resizer = new ResizeObserver(size);
    resizer.observe(section);
    wrap.classList.remove('hidden');

    const w = window as any;
    const api = new Promise<any>((resolve, reject) => {
      w.onYouTubeIframeAPIReady = () => resolve(w.YT);
      const tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      tag.onerror = reject;
      document.head.appendChild(tag);
    });

    /** eager: show as soon as it plays (first player). Otherwise show only once its button has gone. */
    type Handle = {
      frame: HTMLIFrameElement;
      player: any;
      state: number;
      since: number;
      eager: boolean;
      shown: boolean;
      dead: boolean;
    };
    let current: Handle | null = null;
    let next: Handle | null = null;
    let ticker = 0;
    let inView = true;
    let retired = false;

    const spawn = (eager: boolean): Handle => {
      const params = new URLSearchParams({
        autoplay: '1',
        mute: '1',
        controls: '0',
        playsinline: '1',
        rel: '0',
        start: String(eager ? start : WARM_START),
        disablekb: '1',
        iv_load_policy: '3',
        fs: '0',
        modestbranding: '1',
        enablejsapi: '1',
        origin: location.origin,
      });
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${videoId}?${params}`;
      frame.allow = 'autoplay; encrypted-media';
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.tabIndex = -1;
      frame.title = 'Background video';
      wrap.appendChild(frame);
      const h: Handle = { frame, player: null, state: -1, since: 0, eager, shown: false, dead: false };
      api.then((YT) => {
        if (h.dead) return;
        new YT.Player(frame, {
          host: 'https://www.youtube-nocookie.com',
          events: {
            onReady: (e: any) => {
              h.player = e.target;
              // It may have started playing before the API attached.
              h.state = e.target.getPlayerState();
              h.since = performance.now();
              if (h === current) reveal(h);
            },
            onStateChange: (e: any) => {
              h.state = e.data;
              if (e.data === PLAYING) h.since = performance.now();
              // Don't wait for the next tick to show the first frames.
              if (h === current) reveal(h);
            },
            // 100 = gone · 101/150 = embedding disallowed · 2/5 = player fault.
            onError: retire,
          },
        });
      }, retire);
      return h;
    };

    /** Playing, and long enough that YouTube's centre button has hidden itself. */
    const clean = (h: Handle | null) => !!h?.player && h.state === PLAYING && performance.now() - h.since >= HIDE_MS;

    /** Fade a player in once it is ready to be seen. Once shown, it stays shown until it is removed. */
    const reveal = (h: Handle | null) => {
      if (!h || h.shown || !(h.eager ? h.player && h.state === PLAYING : clean(h))) return;
      h.shown = true;
      h.frame.classList.add('is-shown');
    };

    const kill = (h: Handle | null) => {
      if (!h) return;
      h.dead = true;
      h.frame.classList.remove('is-shown');
      window.setTimeout(() => h.frame.remove(), FADE * 1000 + 100);
    };

    const tick = () => {
      if (!current) return;
      reveal(current);
      const t = current.player?.getCurrentTime?.() ?? 0;
      if (!next && current.player && t >= end - PREP) next = spawn(false);
      const due = t >= end - FADE || current.state === ENDED;
      if (next && due && (clean(next) || t >= end + OVERRUN || current.state === ENDED)) {
        // A next player that is late shows as soon as it plays, button or not, rather than leave the hero dark.
        if (!clean(next)) next.eager = true;
        kill(current);
        current = next;
        next = null;
        reveal(current);
      }
    };

    const play = () => {
      if (current || retired) return;
      current = spawn(true);
      ticker = window.setInterval(tick, 250);
    };
    const stop = () => {
      window.clearInterval(ticker);
      kill(current);
      kill(next);
      current = next = null;
    };

    const visibility = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      if (inView) play();
      else stop();
    });
    visibility.observe(section);

    /**
     * RESILIENCE: if the video is removed, made private, region-locked, or has
     * embedding switched off, the iframe renders YouTube's own "Video
     * unavailable" card — which would sit behind the hero copy. Retire the
     * players instead so the designed near-black poster ground stands, exactly
     * as it does with JS off or under reduced motion.
     *
     * Driven by onError (or the API failing to load) ONLY — never by a "hasn't
     * played yet" timer. A muted autoplay legitimately sits at UNSTARTED for a
     * long stretch (backgrounded tab, slow connection, deferred autoplay), and
     * no timer can tell that apart from a dead video. Players are invisible
     * until they play, so a slow one costs nothing on screen.
     */
    function retire() {
      if (retired) return;
      retired = true;
      stop();
      resizer.disconnect();
      visibility.disconnect();
      wrap!.remove();
    }

    if (inView) play();
  }
</script>
