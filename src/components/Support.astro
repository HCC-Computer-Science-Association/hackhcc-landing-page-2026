---
/**
 * Support Us — hackutd's sub-structure minus Partner Hackathons:
 * Social Media → Sponsor → Hack Interest → prospective 2027 note.
 *
 * Social handles are confirmed (mirrored from the Code Runners site footer).
 *
 * PLACEHOLDER: the Interest Form CTA points at mailto:hello@ until a real
 * form URL exists (swap in src/data/site.ts → ctas.interest.href).
 */
import { socials, ctas, contact } from '../data/site';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
---

<section id="support" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-4 py-24 md:py-32">
    <SectionHead title="Support Us" align="right" />

    <div class="space-y-16 md:space-y-20">
      {/* ---- Social Media ---- */}
      <div>
        <h3 class="text-2xl font-extrabold text-white">Social Media</h3>
        <p class="mt-1.5 text-sm font-semibold text-white/45">
          Where announcements land first.
        </p>
        <ul class="mt-7 flex flex-wrap gap-4">
          {
            socials.map((s) => (
              <li class="w-40 sm:w-44 md:w-48">
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex flex-col items-center gap-3 rounded-2xl border border-white/10 bg-panel p-6 transition hover:-translate-y-0.5 hover:border-white/25 hover:shadow-[0_14px_44px_-14px_rgba(236,72,153,0.4)]"
                >
                  <Icon name={s.icon} gradient class="h-9 w-9" />
                  <span class="text-sm font-extrabold text-white">{s.label}</span>
                  <span class="text-xs font-semibold text-white/50">{s.handle}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* ---- Sponsor ---- */}
      <div>
        <h3 class="text-2xl font-extrabold text-white">Sponsor</h3>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-dim md:text-lg">
          Sponsoring HackHCC puts your team in the room while Houston City College students build
          for 24 hours straight: on the prize table, on the swag, and in front of hackers who
          remember who fed them. Tell us what you have in mind and we'll send the details.
        </p>
        <a class="grad-pill mt-7" href={ctas.sponsor.href}>
          <Icon name="envelope" class="h-5 w-5" />
          {ctas.sponsor.label}
        </a>
      </div>

      {/* ---- Hack Interest ---- */}
      <div>
        <h3 class="text-2xl font-extrabold text-white">Hack Interest</h3>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-dim md:text-lg">
          Thinking about hacking with us? Raise your hand now and you'll be the first to know when
          the next HackHCC opens sign-ups. No commitment, and no experience required.
        </p>
        {/* PLACEHOLDER: swap for the real interest-form URL (see site.ts). */}
        <a class="grad-pill mt-7" href={ctas.interest.href}>
          <Icon name="send" class="h-5 w-5" />
          {ctas.interest.label}
        </a>
      </div>

      {/* ---- Prospective 2027 ---- */}
      <div>
        <h3 class="text-xl font-extrabold text-white md:text-2xl">
          Prospective Dates and Location for HackHCC 2027
        </h3>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-dim md:text-lg">
          HackHCC 2027, <span class="font-bold text-white">Control Z</span>, is in production.
          Dates and venue haven't been announced yet; the moment they're locked in, this page and
          our socials will say so. Questions in the meantime go to <a class="font-bold text-white underline decoration-accent decoration-2 underline-offset-4 transition hover:text-accent" href={`mailto:${contact.general}`}>{contact.general}</a>.
        </p>
      </div>
    </div>
  </div>
</section>
